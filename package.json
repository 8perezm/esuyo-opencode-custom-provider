{
  "name": "@esuyo/esuyo-opencode-custom-provider",
  "version": "2.0.4",
  "description": "Opencode plugin to auto-discover models from any OpenAI-compatible gateway",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/",
    "models:json": "node scripts/models-json.mjs",
    "echo-gateway": "node scripts/echo-gateway.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "openai",
    "gateway",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8perezm/esuyo-opencode-custom-provider.git"
  },
  "bugs": {
    "url": "https://github.com/8perezm/esuyo-opencode-custom-provider/issues"
  },
  "homepage": "https://github.com/8perezm/esuyo-opencode-custom-provider#readme",
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0"
  },
  "dependencies": {
    "@opencode-ai/models": "^0.0.116"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29",
    "@types/node": "^26.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
